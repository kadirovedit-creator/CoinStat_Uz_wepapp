BOT_TOKEN=your_bot_token_here

# Telethon (for sending gifts)
# Get from https://my.telegram.org/apps
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=your_phone_number
SESSION_NAME=bot_session
TELETHON_SESSION_STRING=

# Fragment API - https://fragment-api.uz/
FRAGMENT_API_KEY=your_fragment_api_key
FRAGMENT_API_URL=https://fragment-api.uz/api

# Payment system credentials
SHOP_ID=your_shop_id
SHOP_KEY=your_shop_key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database

# Payment Server URL
PAYMENT_SERVER_URL=http://localhost:3000
ADMIN_SECRET=your_admin_secret

# API / Web App URLs
API_PUBLIC_URL=http://localhost:8080
WEBAPP_URL=http://localhost:8080
WEBAPP_BASE_URL=http://localhost:8080
SUPPORT_URL=https://t.me/your_support

# Admin Telegram IDs (comma separated)
ADMIN_IDS=

# Access Control (comma separated usernames, or * for all)
ALLOWED_USERNAMES=*

# API Host/Port
API_HOST=0.0.0.0
API_PORT=8080

# Channel for order notifications
CHANNEL_ORDERS=@ChannelOrders

# Admin Panel Settings
JWT_SECRET_KEY=change-me-to-a-very-long-random-string
JWT_EXPIRATION_HOURS=24
ADMIN_PANEL_URL=http://localhost:8000
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8000
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_this_password
REDIS_URL=redis://localhost:6379/0

# HumoPay API credentials
